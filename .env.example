# HTTP + WebSocket port
PORT=3000
# Liveness/readiness probes: /healthz/live, /healthz/ready
HEALTH_PORT=3001
# Name shown to other peers on the LAN
INSTANCE_NAME=
# Public URL when hosted behind a domain (e.g. https://pong.example.com)
PUBLIC_URL=
# UDP LAN discovery (needs --network host inside Docker)
DISCOVERY_ENABLED=true
DISCOVERY_PORT=41234
# Comma separated list of allowed WebSocket origins, or * for any
ALLOWED_ORIGINS=*
# Optional: enables RedisTransport for multi-pod lobby broadcasts
REDIS_URL=
# Points needed to win a match
DEFAULT_TARGET_SCORE=7
# Initial rating assigned when a display name first completes a match
MMR_INITIAL_RATING=1000
# Zero-sum Elo K-factor
MMR_K_FACTOR=32
